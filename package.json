{
  "name": "@dsh-plugin/dsh-workspace-group",
  "version": "0.1.0",
  "description": "为 DSH 工作区创建分区，支持右键移动、拖动归类和折叠。",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.md", "docs", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc && tsdown --config tsdown.client.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "pnpm run build"
  },
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.3 <0.2.3" },
  "peerDependencies": { "@dsh-plugin/dsh-loader": "^2.0.0-dev.43799314028" },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.43799314028",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@dsh-plugin/dsh-loader", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-context-menu"]
    }
  }
}
