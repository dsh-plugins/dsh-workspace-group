{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "types": ["node"], "strict": true,
    "declaration": true, "outDir": "lib", "rootDir": "src",
    "noEmitOnError": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client"]
}
